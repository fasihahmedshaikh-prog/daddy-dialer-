# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Set these as Supabase Edge Function secrets (NOT in this file's client build):
#   supabase secrets set TWILIO_ACCOUNT_SID=xxxx
#   supabase secrets set TWILIO_AUTH_TOKEN=xxxx
#   supabase secrets set TWILIO_API_KEY=xxxx
#   supabase secrets set TWILIO_API_SECRET=xxxx
#   supabase secrets set TWILIO_TWIML_APP_SID=xxxx
#   supabase secrets set TWILIO_CALLER_NUMBER=+15551234567
